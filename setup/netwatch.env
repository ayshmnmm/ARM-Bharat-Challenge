# Service environment (shipped). Local overrides, e.g. the Llama settings, go in /etc/netwatch/netwatch.env.
NETWATCH_HOME=/var/lib/netwatch
NETWATCH_FEEDS_DIR=/opt/netwatch/feeds/bundles/current
NETWATCH_CUSTOM_FEEDS_DIR=/opt/netwatch/feeds/custom
NETWATCH_WEB_DIR=/opt/netwatch/web/out
NETWATCH_SURICATA_CONFIG=/opt/netwatch/sensor/suricata.yaml
NETWATCH_MAX_RSS_MB=400
# ML detector: one thread each, so scoring never competes with routing
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
