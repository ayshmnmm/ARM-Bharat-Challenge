# NetWatch detection + explanation loop. Reads the sensor log, writes the database.
# It has no network access at all (IPAddressDeny=any, AF_UNIX only).
[Unit]
Description=NetWatch detection and explanations
After=netwatch-sensor.service
Wants=netwatch-sensor.service

[Service]
Type=simple
User=netwatch
Group=netwatch
EnvironmentFile=/opt/netwatch/setup/netwatch.env
EnvironmentFile=-/etc/netwatch/netwatch.env
ExecStart=/opt/netwatch/.venv/bin/python -m netwatch live --eve /var/lib/netwatch/sensor/eve.json
WorkingDirectory=/opt/netwatch
Restart=on-failure
RestartSec=10
StateDirectory=netwatch

IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

Nice=10
CPUQuota=150%
IOWeight=20
# Room for the Llama runner child process (~1.2 GB) once enabled.
LimitAS=4G
OOMScoreAdjust=500

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/netwatch

[Install]
WantedBy=multi-user.target
